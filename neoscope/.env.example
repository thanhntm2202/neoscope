# ============================================================
# NeoScope — mẫu cấu hình bí mật (KHÔNG điền giá trị thật vào
# tệp này rồi commit; sao chép thành .env và giữ .env ngoài Git)
# Chế độ LIVE chỉ dùng API DỮ LIỆU THỊ TRƯỜNG. NeoScope không
# chứa bất kỳ lời gọi đặt/sửa/hủy lệnh nào (xem docs/limitations.md).
# ============================================================

# Tên đăng nhập (số lưu ký VPBankS) và mật khẩu — chỉ dùng để lấy JWT
NEO_USERNAME=
NEO_PASSWORD=

# Định danh thiết bị gửi kèm header x-device (chuỗi UUID tự sinh, ổn định giữa các lần chạy)
NEO_DEVICE_ID=

# Ghi đè endpoint nếu VPBankS thay đổi (mặc định theo docs 17/11/2026)
NEO_AUTH_URL=https://external.vpbanks.com.vn/auth/token
NEO_BASE_URL=https://neoapi.vpbanks.com.vn/neo-api/
NEO_WS_URL=ws://neoapi.vpbanks.com.vn/stock-stream/broker

# Chế độ dữ liệu của dashboard: SYNTHETIC | LIVE
NEOSCOPE_MODE=SYNTHETIC
